#!/bin/sh
# Refuse a push to the public remote that carries deployment secrets or private
# infrastructure. Pushes to the private forge are not gated: they are the working
# side, and gating them would train everyone to pass --no-verify.
#
# Install with:  git config core.hooksPath scripts/git-hooks

set -eu

remote_name="$1"
[ "$remote_name" = "origin" ] || exit 0

zero="0000000000000000000000000000000000000000"
status=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue

    if [ "$remote_sha" = "$zero" ]; then
        # A branch the public remote does not have yet: everything on it is new to it.
        base="$(git merge-base "$local_sha" refs/remotes/origin/HEAD 2>/dev/null || true)"
        [ -n "$base" ] || base="$(git rev-list --max-parents=0 "$local_sha" | tail -1)"
    else
        base="$remote_sha"
    fi

    if ! python3 scripts/scrub-check.py --range "$base..$local_sha"; then
        status=1
    fi
done

[ "$status" -eq 0 ] || echo "
Push refused. Resolve each finding, or record a reviewed exemption in
scripts/publication-allowlist.txt." >&2

exit "$status"
